# Copy to .dev.vars (gitignored) for local development
# wrangler dev will load these automatically

# OpenRouter (free frontier models)
# NOTE: nvidia/llama-3.1-nemotron-ultra-253b-v1:free was RETIRED (OpenRouter 404)
# and is remapped at runtime by normalizeModel(); do not reintroduce it here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL_FAST=meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL_CODE=qwen/qwen3-coder:free
LLM_MODEL_REASONING=gemini-2.5-flash

# Optional: independent free fallbacks tried when OpenRouter's shared free tier
# is exhausted. Workers AI (env.AI) is always-on and needs no key. Grok/Ollama
# are optional. Set these as Worker secrets, not here, in production.
# LLM_GROK_KEY=xai-...
# LLM_OLLAMA_URL=https://<your-ollama-host>
# LLM_MODEL_OLLAMA=llama3.3:70b
 
# Optimus journal — A/B flag for the daily-canvas conditioning path.
# Generation conditions on EXTRACTED THREADS (open questions / claims /
# unaddressed reader requests), not raw prior prose. This flag only controls
# whether the single most-recent entry's prose is also shown for voice
# continuity. Default (unset) = true. Set false to condition on threads alone.
# JOURNAL_INCLUDE_PRIOR_PROSE=false

CLOUDFLARE_ACCOUNT_ID=f60c2e6068e002f5dbad7cd562a5c165

# Connect-back sandbox — ONE shared secret, carried under two names (by design):
#   elle-worker   SANDBOX_AGENT_KEY   (this worker; compared to x-sandbox-key)
#   Elle app      ELLE_SANDBOX_KEY    (sent as x-sandbox-key when the agent polls
#                                      /api/sandbox-bus/poll + /submit)
# They MUST hold the same value. Unset ⇒ the worker's sandbox routes return 503
# and the Elle agent sits idle ("ELLE_SANDBOX_KEY not set; not polling").
# In production set it as a Worker secret, not here:
#   wrangler secret put SANDBOX_AGENT_KEY
# Or bind both sides in one shot:  ./scripts/set-sandbox-key.sh
# SANDBOX_AGENT_KEY=change-me-to-a-long-random-string


# ── Flock — social-media intelligence (src/flock.ts) ─────────────────────────
# Image generation runs on Cloudflare Workers AI (env.AI) by default — free,
# always-on, NO config needed. To transition to a SOVEREIGN / self-hosted image
# model, flip the provider and point it at your endpoint; the whole app then
# draws on your own model with zero code change:
#   FLOCK_IMAGE_PROVIDER=sovereign      # 'workers-ai' (default) | 'sovereign' | 'auto'
#   FLOCK_IMAGE_URL=https://<your-image-endpoint>
#   FLOCK_IMAGE_KEY=<bearer, optional>
#   FLOCK_IMAGE_MODEL=<txt2img model id on your endpoint>
#   FLOCK_IMAGE_MODEL_EDIT=<img2img model id on your endpoint>
# Endpoint contract: POST {prompt, negative_prompt?, width?, height?, model?,
#   image?(base64), strength?} -> JSON {image:"<base64>"} | {images:[...]} OR raw bytes.
#
# Video is a stub until a provider is wired (same call path activates for real):
#   FLOCK_VIDEO_PROVIDER=sovereign
#   FLOCK_VIDEO_URL=https://<your-text-to-video-endpoint>
#   FLOCK_VIDEO_KEY=<bearer, optional>
#   FLOCK_VIDEO_MODEL=<model id>

# ── Payroll provider integrations (src/payroll/*.ts) — per-tenant OAuth ──────
# feeding the tax suite's real wage data. Unset ⇒ each provider's tools/doors
# report "not configured", not an error. In production set ALL of these as
# Worker secrets (wrangler secret put X), never here.
#   PAYROLL_TOKEN_ENC_KEY=<base64, `openssl rand -base64 32`> — encrypts every
#     stored access/refresh token at rest; required before ANY provider works.
#   QUICKBOOKS_CLIENT_ID=... / QUICKBOOKS_CLIENT_SECRET=...
#   QUICKBOOKS_REDIRECT_URI=https://<this-worker>/api/payroll/callback
#   QUICKBOOKS_ENVIRONMENT=sandbox   # 'sandbox' (default) | 'production'
#   GUSTO_CLIENT_ID=... / GUSTO_CLIENT_SECRET=...
#   GUSTO_REDIRECT_URI=https://<this-worker>/api/payroll/callback
#   GUSTO_ENVIRONMENT=demo          # 'demo' (default) | 'production'
#   ADP_CLIENT_ID=... / ADP_CLIENT_SECRET=...
# ADP additionally requires mutual TLS, which secrets alone cannot provide:
#   wrangler mtls-certificate upload --cert adp-cert.pem --key adp-key.pem
#   then add to wrangler.toml:
#     [[mtls_certificates]]
#     binding = "ADP_MTLS_CERT"
#     certificate_id = "<id from the upload command>"
# Until that's done, ADP's connect/sync report "not configured" like any
# other unset integration — it is not a bug, it's the fail-closed default.
